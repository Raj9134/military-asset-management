{
    "name":  "mams-backend",
    "version":  "1.0.0",
    "private":  true,
    "description":  "Military Asset Management System - REST API",
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=20"
                },
    "scripts":  {
                    "start":  "node src/server.js",
                    "bootstrap":  "node scripts/bootstrap.js",
                    "dev":  "nodemon src/server.js",
                    "pretest":  "npm run seed",
                    "test":  "node --test --test-concurrency=1 tests/*.test.js",
                    "prisma:generate":  "prisma generate",
                    "prisma:migrate":  "prisma migrate dev",
                    "prisma:deploy":  "prisma migrate deploy",
                    "prisma:studio":  "prisma studio",
                    "seed":  "node prisma/seed.js",
                    "seed:production":  "node prisma/seed-production.js",
                    "seed:demo-activity":  "node scripts/seed-demo-activity.js",
                    "verify:restore":  "node scripts/verify-restore.js",
                    "verify:constraints":  "node scripts/verify-constraints.js",
                    "verify:inventory":  "node scripts/reconcile-inventory.js"
                },
    "dependencies":  {
                         "@prisma/client":  "^6.2.1",
                         "bcrypt":  "^5.1.1",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.7",
                         "express":  "^4.21.2",
                         "express-rate-limit":  "^7.5.0",
                         "helmet":  "^8.0.0",
                         "jsonwebtoken":  "^9.0.2",
                         "morgan":  "^1.10.0",
                         "zod":  "^3.24.1"
                     },
    "devDependencies":  {
                            "nodemon":  "^3.1.9",
                            "prisma":  "^6.19.3",
                            "supertest":  "^7.0.0"
                        }
}