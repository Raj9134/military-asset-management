# Copy this file to .env and fill in your own values.
# .env is gitignored, so nothing here is ever committed.

# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database ---
# Local PostgreSQL example:
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/mams?schema=public"

# --- Authentication ---
# Generate a real secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
# Comma separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173
